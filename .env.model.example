# OpenClaw 模型配置（供 scripts/update_openclaw_models.sh 使用）
# 目标模式：
# - 默认模型由 `openclaw onboard`（OpenAI Codex OAuth）管理
# - 这个脚本只批量维护自定义 providers/models
#
# 使用方式：
# 1) cp .env.model.example .env.model
# 2) 修改下面变量（尤其 OPENCLAW_PROVIDERS_JSON）
# 3) 先试跑：DRY_RUN=1 scripts/update_openclaw_models.sh
# 4) 正式执行：scripts/update_openclaw_models.sh

# 可选：指定 openclaw 可执行文件路径；不填则自动探测
# OPENCLAW_BIN=/Users/yourname/.openclaw/bin/openclaw

# merge: 保留已有 models.json provider 并叠加本次配置
# replace: 仅保留本次 providers（想彻底覆盖时用）
OPENCLAW_MODELS_MODE=merge

# 是否由脚本设置 agents.defaults.model
# false: 保持 onboard 设置的默认模型（推荐）
# true: 用下面 OPENCLAW_PRIMARY_MODEL / FALLBACKS 覆盖默认模型
OPENCLAW_SET_DEFAULT_MODEL=false

# 是否同步 agents.defaults.models allowlist
# false: 不改 allowlist（避免影响 onboard 新增模型）
# true: 用“自定义 provider 模型 + 可选额外模型”重写 allowlist
OPENCLAW_SYNC_ALLOWLIST=false

# 当 OPENCLAW_SET_DEFAULT_MODEL=true 时使用：
OPENCLAW_PRIMARY_MODEL=openai-codex/gpt-5.3-codex
OPENCLAW_FALLBACK_MODELS_JSON='[
  "custom-coding-plan-aliyuncs/qwen3-max-2026-01-23",
  "custom-coding-plan-aliyuncs/qwen3.5-plus"
]'

# 当 OPENCLAW_SYNC_ALLOWLIST=true 且你仍要保留 onboard 的模型时，可加在这里
OPENCLAW_ALLOWLIST_EXTRA_MODELS_JSON='[
  "openai-codex/gpt-5.3-codex"
]'

# Provider 清单（JSON object）
# 说明：
# - 键是 provider id
# - 可维护多个 provider，每个 provider 下多个模型
# - api 支持：openai-completions / openai-responses / anthropic-messages / google-generative-ai
OPENCLAW_PROVIDERS_JSON='{；
  "custom-api-penguinsaichat-dpdns-org": {
    "baseUrl": "https://api.penguinsaichat.dpdns.org",
    "api": "anthropic-messages",
    "apiKey": "sk-REPLACE_ME",
    "models": [
      {
        "id": "claude-opus-4-6",
        "name": "claude-opus-4-6 (Custom Provider)",
        "reasoning": true,
        "input": ["text", "image"],
        "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
        "contextWindow": 400000,
        "maxTokens": 400000
      }
    ]
  },
  "custom-coding-plan-aliyuncs": {
    "baseUrl": "https://coding.dashscope.aliyuncs.com/v1",
    "api": "openai-completions",
    "apiKey": "sk-REPLACE_ME",
    "models": [
      {
        "id": "qwen3.5-plus",
        "name": "qwen3.5-plus (Custom Provider)",
        "reasoning": true,
        "input": ["text", "image"],
        "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
        "contextWindow": 1000000,
        "maxTokens": 1000000
      },
      {
        "id": "qwen3-max-2026-01-23",
        "name": "qwen3-max (Custom Provider)",
        "reasoning": true,
        "input": ["text", "image"],
        "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
        "contextWindow": 1000000,
        "maxTokens": 1000000
      },
      {
        "id": "qwen3-coder-next",
