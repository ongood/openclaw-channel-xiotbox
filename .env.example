# XiotBox Gateway 配置（桥接/插件共享）
XIOTBOX_GATEWAY_WSS=wss://your-gateway.example.com/ws/openclaw
GATEWAY_API_URL=https://your-gateway.example.com

# 首次配对时需要（10分钟有效期）
PAIR_CODE=YOUR_PAIR_CODE_HERE

# 可选配置
USE_QUERY_AUTH=false
COMMAND_TIMEOUT=300000

# 注意：DEVICE_ID 和 DEVICE_TOKEN 会在配对后自动保存到 config.json
# 不要手动设置这些变量
# 如果是插件模式（OpenClaw 内部运行），可在 OpenClaw 配置 channels.xiotbox 下填入
# 如果是桥接模式，可手动设置：
# XIOTBOX_DEVICE_ID=your_device_id
# XIOTBOX_DEVICE_TOKEN=your_device_token
