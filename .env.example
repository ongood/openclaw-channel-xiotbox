# XiotBox Gateway configuration shared by bridge mode and plugin mode

# WSS endpoint used by the bot-side connection to the Gateway
XIOTBOX_GATEWAY_WSS=wss://gw.xiotbox.com/ws/bot

# REST API endpoint used for pairing, media uploads, and related APIs
GATEWAY_API_URL=https://gw.xiotbox.com

# Required for first-time pairing only.
# Pair codes are typically short-lived (for example 10 minutes) and are issued
# from the XiotBox Lite admin console.
PAIR_CODE=YOUR_PAIR_CODE_HERE

# Optional settings
USE_QUERY_AUTH=false
COMMAND_TIMEOUT=300000

# DEVICE_ID and DEVICE_TOKEN are persisted automatically after pairing into
# config.json / secret.json. Do not set them manually unless you are doing a
# manual bridge-style deployment.
#
# Plugin mode:
#   Put the values under openclaw.json -> channels.xiotbox
#
# Bridge mode:
#   You may set them manually, for example:
# XIOTBOX_DEVICE_ID=your_device_id
# XIOTBOX_DEVICE_TOKEN=your_device_token
