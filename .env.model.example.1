# OpenClaw model configuration template
# Used by: scripts/update_openclaw_models.sh
#
# Purpose:
# - The default model is typically managed by `openclaw onboard`
#   (OpenAI Codex OAuth).
# - This file is only for batch maintenance of custom providers/models.
#
# Suggested workflow:
# 1) cp .env.model.example .env.model
# 2) Edit the variables below, especially OPENCLAW_PROVIDERS_JSON
# 3) Dry run first:
#      DRY_RUN=1 scripts/update_openclaw_models.sh
# 4) Apply the changes:
#      scripts/update_openclaw_models.sh

# Optional: explicit path to the openclaw binary.
# If omitted, the script will try to detect it automatically.
# OPENCLAW_BIN=/Users/yourname/.openclaw/bin/openclaw

# merge: keep existing providers/models and append this configuration
# replace: keep only the providers defined in this file
OPENCLAW_MODELS_MODE=merge

# Whether the script should write agents.defaults.model
# false: keep the default model managed by onboard (recommended)
# true: use OPENCLAW_PRIMARY_MODEL / OPENCLAW_FALLBACK_MODELS_JSON below
OPENCLAW_SET_DEFAULT_MODEL=false

# Whether the script should synchronize agents.defaults.models allowlist
# false: do not modify allowlist
# true: rebuild the allowlist from custom provider models plus optional extras
OPENCLAW_SYNC_ALLOWLIST=true

# How allowlist synchronization should behave
# - merge: merge with the existing allowlist (recommended)
# - replace: fully replace the allowlist generated by this script
OPENCLAW_ALLOWLIST_MODE=merge

# Preserve the current agents.defaults.model(primary/fallbacks) when syncing
OPENCLAW_PRESERVE_DEFAULT_MODEL=true

# Used only when OPENCLAW_SET_DEFAULT_MODEL=true
OPENCLAW_PRIMARY_MODEL=openai-codex/gpt-5.3-codex
OPENCLAW_FALLBACK_MODELS_JSON='[
  "custom-coding-plan-aliyuncs/qwen3-max-2026-01-23",
  "custom-coding-plan-aliyuncs/qwen3.5-plus"
]'

# Extra models to preserve in allowlist when OPENCLAW_SYNC_ALLOWLIST=true
OPENCLAW_ALLOWLIST_EXTRA_MODELS_JSON='[
  "openai-codex/gpt-5.3-codex"
]'

# Provider list (JSON object)
# Notes:
# - Keys are provider ids
# - You can maintain multiple providers, each with multiple models
# - Supported `api` values:
