{
    "name": "openclaw-channel-xiotbox",
    "version": "1.0.0",
    "description": "OpenClaw plugin for XiotBox connectivity via WebSocket",
    "type": "module",
    "main": "index.ts",
    "keywords": [
        "openclaw-plugin",
        "xiotbox",
        "channel"
    ],
    "author": "OpenClaw",
    "license": "MIT",
    "scripts": {
        "start": "node bridge.js"
    },
    "dependencies": {
        "ws": "^8.13.0",
        "dotenv": "^16.0.3"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.8.0"
    },
    "openclaw": {
        "extensions": [
            "./index.ts"
        ],
        "channels": [
            "xiotbox"
        ],
        "installDependencies": true,
        "channel": {
            "id": "xiotbox",
            "label": "XiotBox",
            "selectionLabel": "XiotBox Gateway",
            "blurb": "Connects to XiotBox Gateway via WebSocket Secure (WSS) protocol.",
            "order": 100
        }
    }
}
