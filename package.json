{
  "name": "xiotbox",
  "version": "2.0.5",
  "description": "OpenClaw plugin for XiotBox connectivity via WebSocket",
  "type": "module",
  "main": "dist/index.js",
  "keywords": [
    "openclaw-plugin",
    "xiotbox",
    "channel"
  ],
  "author": "OpenClaw",
  "license": "MIT",
  "scripts": {
    "start": "node bridge.js",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "check:env": "node scripts/check_no_env_outside_runtime_config.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@noble/curves": "^1.4.0",
    "ws": "^8.13.0",
    "dotenv": "^16.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openclaw": "^2026.3.24",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.22"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    ".env.example",
    "wss_client.js",
    "bridge.js",
    "config.js",
    "executor.js"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "channels": [
      "xiotbox"
    ],
    "installDependencies": true,
    "install": {
      "npmSpec": "xiotbox",
      "localPath": "extensions/xiotbox",
      "defaultChoice": "local",
      "minHostVersion": ">=2026.3.22"
    },
    "channel": {
      "id": "xiotbox",
      "label": "XiotBox",
      "selectionLabel": "XiotBox Gateway",
      "blurb": "Connects to XiotBox Gateway via WebSocket Secure (WSS) protocol.",
      "order": 100
    }
  }
}
